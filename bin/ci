#!/usr/bin/env bash
# The exact checks CI runs — keep this and .github/workflows/ci.yml in lockstep so
# "green locally" means "green in CI". Non-zero on any failure.
set -euo pipefail

echo "==> ruff format"; uv run ruff format --check .
echo "==> ruff lint";   uv run ruff check .

echo "==> test";         uv run pytest

echo "==> audit";       uv run pip-audit

echo "==> litellm proxy"
# The app talks only to the local LiteLLM proxy (AGENTS.md hurdle: it must be running
# for the app to work). Unit tests mock the LLM, so no check here *needs* the proxy —
# and this script also runs in GitHub Actions, where localhost:4000 can never exist.
# So the probe warns loudly instead of failing: reachable → OK; unreachable → SKIPPED.
if curl -sf --max-time 3 http://localhost:4000/v1/models >/dev/null 2>&1; then
    echo "    litellm proxy reachable"
else
    echo "    SKIPPED (litellm proxy not reachable — needed for integration runs)"
fi

echo "==> markdown is soft-wrapped"
# One paragraph, one line. Rewrapping belongs to whatever renders the text, since that is
# the only thing that knows the reader's width. It is a gate rather than a written rule
# because hard wrap spreads by contact: every editor and agent inherits the wrap of the
# file it is editing. It also prevents a real defect, where a break landing in front of
# `#`, `-`, `>` or `1.` turns the continuation into a block.
python3 scripts/md-unwrap.py --check .

# Last, so a prose finding never hides a broken build. --diff and not a tree scan: this
# repo had prose before the gate, so a tree scan would be red on install and stay red,
# which is the failure mode of every signal that never changes state. This way existing
# text is left alone and nothing new can add a tell.
echo "==> slop-guard"; bin/slop-guard --diff "${SLOP_GUARD_BASE:-origin/master}"

echo "CI green."
