#!/usr/bin/env bash
# Deterministic secret gate: block any commit that stages a secret. A hook never
# forgets, unlike the AGENTS.md reminder; CI re-scans so a `--no-verify` bypass is
# still caught at the PR.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed — https://github.com/gitleaks/gitleaks" >&2
  exit 1
fi

gitleaks git --staged --no-banner --redact
